# Copy values into the host's private environment settings.
# This example contains no live credentials.
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=require
HES_MODE=simulator
NOTIFICATION_MODE=simulator
CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
SCANNER_URL=https://YOUR-PROJECT.vercel.app
# Enable live mode only after mapping and testing authorised interfaces.
HES_ISKRA_URL=
HES_ISKRA_TOKEN=
HES_SECURE_URL=
HES_SECURE_TOKEN=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MANAGER_EMAIL=
HES_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_CONTENT_SID=
MANAGER_WHATSAPP=
HES_WHATSAPP=
